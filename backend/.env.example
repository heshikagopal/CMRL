APP_NAME="CMRL IT Asset Management & Monitoring System"
APP_ENV="development"
# Primary Enterprise PostgreSQL connection string:
# DATABASE_URL="postgresql+psycopg2://cmrl_admin:cmrl_secure_pass@localhost:5432/cmrl_itam"
# Local development zero-config SQLite fallback:
DATABASE_URL="sqlite:///./cmrl_itam.db"

# Security - Generate a strong random secret key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="replace-with-secure-random-hex-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173"

# File Uploads & QR Storage
UPLOAD_DIR="storage/uploads"
QR_DIR="storage/qrcodes"
MAX_UPLOAD_SIZE_MB=10

# Demo Data Seeding
AUTO_SEED_DEMO=true
FRONTEND_BASE_URL="http://localhost:5173"
